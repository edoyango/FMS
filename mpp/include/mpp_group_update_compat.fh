!> Rank-4 version of the scalar @ref MPP_RESET_GROUP_UPDATE_FIELD_
subroutine MPP_RESET_GROUP_UPDATE_FIELD_4D_(group, field)
  type(mpp_group_update_type), intent(inout) :: group
