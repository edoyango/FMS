end subroutine MPP_CREATE_GROUP_UPDATE_3D_

!> Rank-3 version of the vector @ref MPP_CREATE_GROUP_UPDATE_V_
subroutine MPP_CREATE_GROUP_UPDATE_3DV_(group, fieldx, fieldy, domain, flags, gridtype, whalo, ehalo, shalo, nhalo, &
                                           xdim, ydim)
  type(mpp_group_update_type), intent(inout) :: group
  MPP_TYPE_, intent(inout), target :: fieldx(:,:,:), fieldy(:,:,:)
  type(domain2D), intent(inout) :: domain
  integer, intent(in), optional :: flags, gridtype
  integer, intent(in), optional :: whalo, ehalo, shalo, nhalo
  integer, intent(in), optional :: xdim, ydim

  call MPP_CREATE_GROUP_UPDATE_V_(group, fieldx, fieldy, domain, flags, gridtype, whalo, ehalo, shalo, nhalo, &
                                  xdim, ydim)
  group%addrs_x(group%nvector) = c_loc(fieldx)
  group%addrs_y(group%nvector) = c_loc(fieldy)
end subroutine MPP_CREATE_GROUP_UPDATE_3DV_

!> Rank-3 version of the scalar @ref MPP_RESET_GROUP_UPDATE_FIELD_
subroutine MPP_RESET_GROUP_UPDATE_FIELD_3D_(group, field)
  type(mpp_group_update_type), intent(inout) :: group
  MPP_TYPE_, intent(in), target :: field(:,:,:)

  call MPP_RESET_GROUP_UPDATE_FIELD_(group, field)
  group%addrs_s(group%reset_index_s) = c_loc(field)
end subroutine MPP_RESET_GROUP_UPDATE_FIELD_3D_

!> Rank-3 version of the vector @ref MPP_RESET_GROUP_UPDATE_FIELD_V_
subroutine MPP_RESET_GROUP_UPDATE_FIELD_3DV_(group, fieldx, fieldy)
  type(mpp_group_update_type), intent(inout) :: group
  MPP_TYPE_, intent(in), target :: fieldx(:,:,:), fieldy(:,:,:)

  call MPP_RESET_GROUP_UPDATE_FIELD_V_(group, fieldx, fieldy)
  group%addrs_x(group%reset_index_v) = c_loc(fieldx)
  group%addrs_y(group%reset_index_v) = c_loc(fieldy)
end subroutine MPP_RESET_GROUP_UPDATE_FIELD_3DV_

